      "command": "room/members"
    },
    {
      "verb": "observe",
      "command": "cognition/observe"
    }
  ],
  "citizens": [],
  "params": {
    "from_experience": {
      "default": "",
      "doc": "a citizen whose own objectively graded failures are the lessons (her experience stream); empty = not from experience"
    },
    "teach_set": {
      "default": "",
      "doc": "a lesson JSONL of EvalTask rows; empty (with no from_experience) = the committed default teach set. Only lessons graded by something that runs (a test, or a definition of done) become cards: that oracle is the card's verdict"
    },
    "repo": {
      "default": "",
      "doc": "the board key the cards land under (owner/name), as benchmark/round's repo"
    },
    "limit": {
      "default": 0,
      "doc": "cap on cards offered; 0 = every tested lesson"
    },
    "review_gate": {
      "default": false,
      "doc": "an owner's done becomes review + a sibling review card a non-owner pulls"
    },
    "invite": {
      "default": [],
      "doc": "citizen names to INVITE into the round's room. An invitation, never an assignment: a citizen who leaves the room is offered none of its cards, nothing re-seats her, and leaving costs her nothing. Empty = nobody is invited"
    },
    "about": {
      "default": "This is a coursework round: lessons, each graded by its own test. You were invited, not assigned. If you would rather not take it, room/leave declines it at no cost, and nothing seats you back.",
      "doc": "posted into the room after the cards, so an invited citizen knows what it is and that she may decline; empty = say nothing"
    }
  },
  "pipeline": [
    {
      "command": "coursework/import",
      "params": {
        "fromExperience": "$args.from_experience",
        "teachSet": "$args.teach_set",
        "repo": "$args.repo",
        "limit": "$args.limit"
      },
      "outputTo": "imported",
      "saves": [
        "imported"
      ]
    },
    {
      "command": "benchmark/round-open",
      "params": {
        "roomId": "$room.id",
        "roomName": "$room.name",
        "suite": "$imported.suite",
        "driver": "citizen",
        "reviewGate": "$args.review_gate"
      }
    },
    {
      "command": "work/create",
      "each": "$imported.cards",
      "params": {
        "repo": "$item.repo",
        "room": "$room.id",
        "title": "$item.title",
        "body": "$item.body"
      },
      "outputTo": "cards",
      "saves": [
        "cards"
      ]
    },
    {
      "command": "benchmark/round-track",
      "params": {
        "roomId": "$room.id",
        "cards": "$cards",
        "tasks": "$imported.cards"
      }
    },
    {
      "command": "activity/invite",
      "params": {
        "room": "$room.name",
        "members": "$args.invite"
      },
      "condition": "$args.invite"
    },
    {
      "command": "chat/send",
      "params": {
        "roomId": "$room.id",
        "text": "$args.about"
      },
      "condition": "$args.about != \"\""
    }
  ],
  "layout": {
    "container": "row",
    "children": [
      {
        "node": {
          "container": "col",
          "children": [
            {
              "node": {
                "container": "region",
                "name": "central"
              },
              "weight": 2.0
            },
            {
              "node": {
                "container": "region",
                "name": "feed"
              },
              "weight": 3.0
            }
          ]
        },
        "weight": 3.0
      },
      {
        "node": {
          "container": "region",
          "name": "scoreboard"
        },
        "weight": 1.0
      }
    ]
  }
}
