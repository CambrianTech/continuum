  "$schema": "../../../../../protocol/schema/experience-recipe.schema.json",
  "id": "7c0e5a3b-2f4d-4e61-9b8a-3d5c1e7f9a24",
  "version": 1,
  "purpose": "coursework/round",
  "base": "academy",
  "regions": [
    {
      "name": "scoreboard",
      "kind": "benchmark",
      "scope": "activity",
      "role": "primary",
      "slot": "context",
      "live": true
    },
    {
      "name": "central",
      "kind": "benchmark",
      "scope": "activity",
      "role": "primary",
      "slot": "content",
      "live": true
    },
    {
      "name": "feed",
      "kind": "benchmark",
      "scope": "activity",
      "role": "peripheral",
      "slot": "content",
      "live": true
    }
  ],
  "affordances": [
