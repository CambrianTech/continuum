      "command": "code/write"
    },
    {
      "verb": "run",
      "command": "code/run"
    },
    {
      "verb": "shell",
      "command": "code/shell"
    },
    {
      "verb": "git-status",
      "command": "code/git/status"
    },
    {
      "verb": "git-diff",
      "command": "code/git/diff"
    },
    {
      "verb": "git-commit",
      "command": "code/git/commit"
    },
    {
      "verb": "shell-poll",
      "command": "code/shell-poll"
    },
    {
      "verb": "git-add",
      "command": "code/git/add"
    },
    {
      "verb": "git-push",
      "command": "code/git/push"
    },
    {
      "verb": "pr-create",
      "command": "code/github/pr-create"
    },
    {
      "verb": "pr-comment",
      "command": "code/github/pr-comment"
    },
    {
