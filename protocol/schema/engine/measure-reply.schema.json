{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MeasureReply",
  "type": "object",
  "required": [
    "examples",
    "window"
  ],
  "properties": {
    "examples": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/MeasuredExample"
      }
    },
    "window": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    }
  },
  "definitions": {
    "ExampleFit": {
      "type": "string",
      "enum": [
        "kept",
        "truncated",
        "skipped"
      ]
    },
    "MeasuredExample": {
      "description": "One example as `/train/measure` reports it (fork #51).",
      "type": "object",
      "required": [
        "fit",
        "index",
        "tokens_full",
        "tokens_min",
        "tokens_trained"
      ],
      "properties": {
        "fit": {
          "$ref": "#/definitions/ExampleFit"
        },
        "index": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "tokens_full": {
          "description": "rendered tokens before anything is dropped",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "tokens_min": {
          "description": "the smallest window it trains in: the head plus her last exchange",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "tokens_trained": {
          "description": "tokens as it would train at this window (0 when skipped)",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      }
    }
  }
}
