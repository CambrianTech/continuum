{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MeasureRequest",
  "description": "`POST /train/measure`'s body: how each example fits a window, measured by the engine's own renderer before a run is sent (fork #51).",
  "type": "object",
  "required": [
    "examples",
    "window"
  ],
  "properties": {
    "examples": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/EngineExample"
      }
    },
    "fit": {
      "anyOf": [
        {
          "$ref": "#/definitions/Fit"
        },
        {
          "type": "null"
        }
      ]
    },
    "window": {
      "description": "a multiple of 256, at least 256, at most the model's trained context",
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    }
  },
  "definitions": {
    "EngineExample": {
      "description": "One `/train` example: a prompt/completion pair, or a served conversation (OpenAI message shape exactly as serving framed it, with the tools she was offered).",
      "anyOf": [
        {
          "type": "object",
          "required": [
            "completion",
            "prompt"
          ],
          "properties": {
            "completion": {
              "type": "string"
            },
            "prompt": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "messages"
          ],
          "properties": {
            "messages": {
              "type": "array",
              "items": true
            },
            "tools": true
          }
        }
      ]
    },
    "Fit": {
      "description": "How an example longer than the window is fitted (fork #29).",
      "oneOf": [
        {
          "description": "keep the system and tool head and her reply; drop the OLDEST history exchanges",
          "type": "string",
          "enum": [
            "middle"
          ]
        },
        {
          "description": "cut from the front",
          "type": "string",
          "enum": [
            "left"
          ]
        }
      ]
    }
  }
}
