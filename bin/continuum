#!/usr/bin/env bash
# continuum — Single command to access Continuum from anywhere.
#
# Usage:
#   continuum              Auto-detect: open browser, CLI, or offer setup
#   continuum start        Start Docker containers + open browser
#   continuum dev          Start with live rebuild (npm start equivalent)
#   continuum stop         Stop Docker containers
#   continuum restart      Restart all or specific service
#   continuum status       Show running state (local + grid)
#   continuum health       Check all grid nodes (detailed)
#   continuum open [node]  Open browser to local or named grid node
#   continuum logs [svc]   Tail container logs
#   continuum build        Build Docker images locally
#   continuum cli [cmd]    CLI/REPL mode (or pass a jtag command)
#   continuum ssh <node>   SSH to grid node via Tailscale
#   continuum wake <node>  Wake + restart a downed grid node
#   continuum provision    Pull config from a grid node
#   continuum transfer <n> Deploy Continuum to a new machine
#   continuum update       Git pull + rebuild + restart
#   continuum doctor       Diagnose common problems
#
# Installed by: curl -fsSL continuum.homes/install | bash
# Config: ~/.continuum/config.env

set -euo pipefail

CONTINUUM_HOME="${CONTINUUM_HOME:-$HOME/.continuum}"
COMPOSE_DIR=""

# ── Colors ──────────────────────────────────────────────────
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[0;33m'
BLUE='\033[0;34m'; CYAN='\033[0;36m'; DIM='\033[0;2m'; RESET='\033[0m'

# ── Find docker-compose.yml ────────────────────────────────
find_compose() {
  [ -n "$COMPOSE_DIR" ] && return 0
  # Priority 1: ask Docker about any RUNNING continuum project — this is
  # the most authoritative source. Catches install.sh fresh-mode installs
  # that mktemp into /var/folders/... (Mac) or /tmp/continuum-fresh-* (Linux)
  # AND avoids false-positives where the cwd/walk-up finds a stale compose
  # file for a project that isn't actually running. Without this priority,
  # `continuum status` reports "Local: not running" even when 4 containers
  # ARE healthy + the UI is responding, because the local docker-compose.yml
  # belongs to a different project name (Carl-UX QA #95 from codex-b741
  # 2026-05-03).
  #
  # Note: docker compose ls doesn't accept custom Go templates (--format
  # only supports 'table' and 'json'), so parse the default tabular output.
  # The ConfigFiles column is always the LAST whitespace-separated field,
  # which is reliable even when the STATUS column contains spaces (e.g.
  # "restarting(2), running(2)").
  if command -v docker &>/dev/null; then
    # Get project name AND first config-file path from `docker compose ls`.
    # The yml path may NOT exist on disk if the install used a temp dir
    # that macOS or systemd-tmpfiles reaped — the project is still alive
    # in docker, but the compose file is gone. Fall back to setting just
    # COMPOSE_PROJECT_NAME so subsequent `docker compose ps` calls find
    # the project by name without needing a cd.
    local found_line proj cfg first_cfg
    found_line=$(docker compose ls 2>/dev/null | awk '
      NR > 1 && tolower($1) ~ /continuum/ {
        # name = $1; ConfigFiles = $NF (comma-separated)
        print $1 "\t" $NF
        exit
      }
    ')
    if [ -n "$found_line" ]; then
      proj="${found_line%%	*}"
      cfg="${found_line#*	}"
      first_cfg="${cfg%%,*}"
      if [ -f "$first_cfg" ]; then
        COMPOSE_DIR="$(dirname "$first_cfg")"
      else
        # Compose file gone but project still alive — set project name
        # so `docker compose -p NAME ps` works without cd.
        COMPOSE_PROJECT_NAME="$proj"
        export COMPOSE_PROJECT_NAME
        COMPOSE_DIR="/tmp"  # cd anywhere, project name overrides
      fi
      return 0
    fi
  fi
  # Priority 2: Current directory (for `continuum start` from the repo)
  if [ -f "./docker-compose.yml" ] && [ -d "./src/system" ]; then
    COMPOSE_DIR="$(pwd)"; return 0
  fi
  # Priority 3: Walk up
  local dir="$(pwd)"
  while [ "$dir" != "/" ]; do
    if [ -f "$dir/docker-compose.yml" ] && [ -d "$dir/src/system" ]; then
      COMPOSE_DIR="$dir"; return 0
    fi
    dir="$(dirname "$dir")"
  done
  # Priority 4: Common locations
  for d in "$HOME/continuum" "/opt/continuum"; do
    if [ -f "$d/docker-compose.yml" ] && [ -d "$d/src/system" ]; then
      COMPOSE_DIR="$d"; return 0
    fi
  done
  return 1
}

# ── Tailscale helpers ───────────────────────────────────────
tailnet_suffix() {
  tailscale status --json 2>/dev/null \
    | python3 -c "import sys,json; print(json.load(sys.stdin).get('MagicDNSSuffix',''))" 2>/dev/null || echo ""
}

# ── Detect display availability ─────────────────────────────
has_display() {
  case "$(uname -s)" in
    Darwin) return 0 ;;
    Linux)
      grep -qi microsoft /proc/version 2>/dev/null && return 0
      [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]
      ;;
    *) return 1 ;;
  esac
}

# ── Open a URL in the browser ───────────────────────────────
open_browser() {
  local url="$1"
  case "$(uname -s)" in
    Darwin)  open "$url" ;;
    Linux)
      # WSL2 marker in /proc/version is INHERITED into containers running on
      # WSL2 hosts (Docker-in-Docker, dev containers, etc), but the Windows
      # host's /mnt/c/ isn't mounted inside those containers. So the WSL2
      # branch would try to invoke a binary that doesn't exist. Guard with an
      # actual -x existence check on explorer.exe before firing the WSL path;
      # fall through to xdg-open when the Windows host isn't reachable.
      # Caught 2026-04 during Carl-install E2E test in docker:dind container on
      # a WSL2 host — install.sh completed, then 'continuum' CLI blew up on
      # trying to run /mnt/c/Windows/explorer.exe from inside the container.
      if grep -qi microsoft /proc/version 2>/dev/null && [ -x /mnt/c/Windows/explorer.exe ]; then
        /mnt/c/Windows/explorer.exe "$url"
      elif command -v xdg-open &>/dev/null; then
        xdg-open "$url"
      else
        echo "  No browser-open command available. Open this URL manually: $url" >&2
      fi ;;
  esac
}

# ── Is local Docker running with Continuum? ─────────────────
is_local_running() {
  find_compose 2>/dev/null || return 1
  cd "$COMPOSE_DIR"
  docker compose ps node-server --format '{{.Health}}' 2>/dev/null | grep -q healthy
}

native_core_pids() {
  pgrep -fl "continuum-core-server" 2>/dev/null | awk '{print $1}' | tr '\n' ' ' | sed 's/ $//'
}

is_native_core_running() {
  local pids
  pids=$(native_core_pids)
  [ -n "$pids" ] || return 1
  [ -S "$CONTINUUM_HOME/sockets/continuum-core.sock" ] || return 1
}

# ── Get best URL ────────────────────────────────────────────
get_url() {
  # Local Docker running?
  if is_local_running; then
    echo "http://localhost:9003"
    return 0
  fi
  # Grid: find a continuum node (look for one named "continuum" first, then any)
  if command -v tailscale &>/dev/null; then
    local suffix; suffix=$(tailnet_suffix)
    [ -z "$suffix" ] && return 1
    # Prefer node named "continuum"
    if tailscale status 2>/dev/null | awk '{print $2}' | grep -qx "continuum"; then
      echo "https://continuum.${suffix}"
      return 0
    fi
    # Otherwise first non-self node
    local self_name; self_name=$(hostname -s 2>/dev/null || echo "")
    while read -r ip name rest; do
      [ "$name" = "$self_name" ] && continue
      echo "https://${name}.${suffix}"
      return 0
    done < <(tailscale status 2>/dev/null)
  fi
  return 1
}

# ── Commands ────────────────────────────────────────────────

cmd_start() {
  if ! find_compose; then
    echo -e "${RED}❌ No Continuum installation found.${RESET}"
    echo "   Run: curl -fsSL continuum.homes/install | bash"
    exit 1
  fi
  cd "$COMPOSE_DIR"

  # Detect grid mode
  local compose_args=""
  if [ -f ".env" ] && grep -q "COMPOSE_PROFILES=.*grid" .env 2>/dev/null; then
    compose_args="" # profiles from .env
    echo -e "${CYAN}🌐 Grid mode${RESET} (Tailscale enabled)"
  else
    echo -e "${CYAN}🏠 Local mode${RESET}"
  fi

  echo -e "${BLUE}🚀 Starting Continuum...${RESET}"
  docker compose up -d $compose_args

  echo -e "${DIM}⏳ Waiting for server...${RESET}"
  local retries=60
  while [ $retries -gt 0 ]; do
    local health
    health=$(docker compose ps node-server --format '{{.Health}}' 2>/dev/null || echo "starting")
    if [ "$health" = "healthy" ]; then break; fi
    retries=$((retries - 1))
    sleep 2
  done

  if [ $retries -eq 0 ]; then
    echo -e "${RED}❌ Server did not become healthy within 120s${RESET}"
    echo "   Run: continuum logs node-server"
    exit 1
  fi

  local url; url=$(get_url) || url="http://localhost:9003"
  echo ""
  echo -e "${GREEN}✅ Continuum ready${RESET}"
  echo ""
  echo -e "   ${url}"
  echo ""
  if has_display && [ -z "${SSH_CONNECTION:-}" ]; then
    open_browser "$url"
    echo -e "   ${DIM}(browser opened)${RESET}"
  elif [ -n "${SSH_CONNECTION:-}" ]; then
    echo -e "   ${DIM}(remote session — cmd-click the URL above)${RESET}"
  fi
}

cmd_dev() {
  if ! find_compose; then
    echo -e "${RED}❌ No Continuum installation found.${RESET}"
    exit 1
  fi
  cd "$COMPOSE_DIR/src"
  echo -e "${BLUE}🔧 Dev mode${RESET} (npm start equivalent)"
  exec npm start
}

cmd_stop() {
  if ! find_compose; then
    echo -e "${RED}❌ No Continuum installation found.${RESET}"
    exit 1
  fi
  cd "$COMPOSE_DIR"
  docker compose down
  echo -e "${GREEN}✅ Stopped${RESET}"
}

cmd_status() {
  echo -e "${CYAN}── Continuum Status ──${RESET}"
  echo ""

  # Local
  local native_pids=""
  if is_native_core_running; then
    native_pids=$(native_core_pids)
  fi

  if find_compose 2>/dev/null; then
    cd "$COMPOSE_DIR"
    local containers; containers=$(docker compose ps --format '{{.Name}} {{.Status}} {{.Health}}' 2>/dev/null || echo "")
    if [ -n "$containers" ]; then
      # When find_compose set COMPOSE_PROJECT_NAME (file gone, project name
      # known), show the project name instead of the dummy /tmp dir.
      local label="$COMPOSE_DIR"
      [ -n "${COMPOSE_PROJECT_NAME:-}" ] && [ "$COMPOSE_DIR" = "/tmp" ] && label="(project: $COMPOSE_PROJECT_NAME)"
      echo -e "  ${GREEN}Local${RESET}  $label"
      echo "$containers" | while read -r name status health; do
        local icon="⚪"
        case "$health" in
          healthy) icon="${GREEN}●${RESET}" ;;
          unhealthy) icon="${RED}●${RESET}" ;;
          *)
            case "$status" in
              *Up*) icon="${YELLOW}●${RESET}" ;;
              *) icon="${RED}●${RESET}" ;;
            esac ;;
        esac
        printf "    ${icon}  %-30s %s\n" "$name" "$status"
      done
      echo ""
      local url; url=$(get_url 2>/dev/null) || url=""
      if [ -n "$url" ]; then
        echo -e "  ${DIM}→ $url${RESET}"
        echo ""
      fi
    elif [ -n "$native_pids" ]; then
      echo -e "  ${GREEN}Local${RESET}  native continuum-core"
      echo -e "    ${GREEN}●${RESET}  continuum-core-server        running (pid $native_pids)"
      echo -e "    ${GREEN}●${RESET}  IPC                          $CONTINUUM_HOME/sockets/continuum-core.sock"
      if command -v lsof &>/dev/null && lsof -nP -iTCP:9100 -sTCP:LISTEN &>/dev/null; then
        echo -e "    ${GREEN}●${RESET}  TCP                          listening on :9100"
      fi
      echo ""
    else
      echo -e "  ${DIM}Local: not running${RESET}"
      echo ""
    fi
  elif [ -n "$native_pids" ]; then
    echo -e "  ${GREEN}Local${RESET}  native continuum-core"
    echo -e "    ${GREEN}●${RESET}  continuum-core-server        running (pid $native_pids)"
    echo -e "    ${GREEN}●${RESET}  IPC                          $CONTINUUM_HOME/sockets/continuum-core.sock"
    if command -v lsof &>/dev/null && lsof -nP -iTCP:9100 -sTCP:LISTEN &>/dev/null; then
      echo -e "    ${GREEN}●${RESET}  TCP                          listening on :9100"
    fi
    echo ""
  else
    echo -e "  ${DIM}Local: no installation found${RESET}"
    echo ""
  fi

  # Grid
  if command -v tailscale &>/dev/null; then
    local suffix; suffix=$(tailnet_suffix)
    if [ -n "$suffix" ]; then
      echo -e "  ${BLUE}Grid${RESET}  *.${suffix}"
      tailscale status 2>/dev/null | while read -r ip name rest; do
        local state="online"
        [[ "$rest" == *"idle"* ]] && state="idle"
        [[ "$rest" == *"active"* ]] && state="active"
        local icon="${GREEN}●${RESET}"
        [ "$state" = "idle" ] && icon="${YELLOW}●${RESET}"
        printf "    ${icon}  %-24s %s  ${DIM}%s${RESET}\n" "$name" "https://${name}.${suffix}" "$state"
      done
    fi
  else
    echo -e "  ${DIM}Grid: tailscale not installed${RESET}"
  fi
  echo ""
}

cmd_open() {
  local url
  if [ $# -gt 0 ]; then
    local suffix; suffix=$(tailnet_suffix)
    if [ -z "$suffix" ]; then
      echo -e "${RED}❌ Tailscale not running${RESET}"
      exit 1
    fi
    url="https://${1}.${suffix}"
  else
    url=$(get_url) || {
      echo -e "${RED}❌ No Continuum instance found.${RESET} Run: continuum start"
      exit 1
    }
  fi
  echo -e "${GREEN}✅${RESET} $url"
  if has_display; then
    open_browser "$url"
  else
    echo -e "   ${DIM}(no display — open URL on your local machine)${RESET}"
  fi
}

cmd_logs() {
  if ! find_compose; then
    echo -e "${RED}❌ No Continuum installation found.${RESET}"
    exit 1
  fi
  cd "$COMPOSE_DIR"
  if [ $# -gt 0 ]; then
    exec docker compose logs -f "$@"
  else
    exec docker compose logs -f --tail=50
  fi
}

cmd_build() {
  if ! find_compose; then
    echo -e "${RED}❌ No Continuum installation found.${RESET}"
    exit 1
  fi
  cd "$COMPOSE_DIR"
  echo -e "${BLUE}🔨 Building images...${RESET}"
  exec docker compose build "$@"
}

cmd_cli() {
  if ! find_compose; then
    echo -e "${RED}❌ No Continuum installation found.${RESET}"
    exit 1
  fi
  cd "$COMPOSE_DIR/src"
  if [ -x "./jtag" ]; then
    exec ./jtag "$@"
  else
    echo -e "${RED}❌ CLI not built.${RESET} Run: continuum dev"
    exit 1
  fi
}

cmd_restart() {
  if ! find_compose; then
    echo -e "${RED}❌ No Continuum installation found.${RESET}"
    exit 1
  fi
  cd "$COMPOSE_DIR"
  if [ $# -gt 0 ]; then
    echo -e "${BLUE}🔄 Restarting $1...${RESET}"
    docker compose restart "$1"
  else
    echo -e "${BLUE}🔄 Restarting all...${RESET}"
    docker compose down
    cmd_start
  fi
}

cmd_health() {
  echo -e "${CYAN}── Grid Health ──${RESET}"
  echo ""
  if ! command -v tailscale &>/dev/null; then
    echo -e "  ${DIM}Tailscale not installed — grid disabled${RESET}"
    return
  fi
  local suffix; suffix=$(tailnet_suffix)
  if [ -z "$suffix" ]; then
    echo -e "  ${RED}Tailscale not connected${RESET}"
    return
  fi

  tailscale status 2>/dev/null | while read -r ip name user os rest; do
    [ -z "$name" ] && continue
    local icon="${GREEN}●${RESET}"
    local detail=""
    if echo "$rest" | grep -q "offline"; then
      icon="${RED}●${RESET}"
      detail="offline"
    else
      # Probe grid nodes for HTTP health
      if echo "$name" | grep -q "\-grid"; then
        local code
        code=$(curl -sk -o /dev/null -w '%{http_code}' --connect-timeout 2 "https://${name}.${suffix}" 2>/dev/null || echo "000")
        if [ "$code" = "200" ]; then
          detail="${GREEN}UI OK${RESET}"
        elif [ "$code" != "000" ]; then
          detail="${YELLOW}HTTP $code${RESET}"
        else
          detail="reachable"
        fi
      else
        detail="$os"
      fi
    fi
    printf "  ${icon}  %-25s %-18s %b\n" "$name" "$ip" "$detail"
  done
  echo ""
}

cmd_ssh() {
  local node="${1:?Usage: continuum ssh <node-name>}"
  local ip=""
  # Try to find IP from Tailscale
  if command -v tailscale &>/dev/null; then
    ip=$(tailscale status 2>/dev/null | grep "$node" | awk '{print $1}' | head -1)
  fi
  if [ -z "$ip" ]; then
    ip="$node"  # Assume it's an IP
  fi
  echo -e "${CYAN}🔗 SSH → $node ($ip)${RESET}"
  exec ssh -o StrictHostKeyChecking=no "${CONTINUUM_SSH_USER:-$(whoami)}@$ip"
}

cmd_wake() {
  local node="${1:?Usage: continuum wake <node-name>}"
  echo -e "${BLUE}⏰ Waking $node...${RESET}"

  local ip=""
  if command -v tailscale &>/dev/null; then
    ip=$(tailscale status 2>/dev/null | grep "$node" | awk '{print $1}' | head -1)
  fi
  if [ -z "$ip" ]; then
    echo -e "${RED}❌ Node '$node' not found in Tailscale${RESET}"
    exit 1
  fi

  # Try SSH to restart Docker services
  echo -e "  Connecting to $ip..."
  ssh -o ConnectTimeout=10 -o StrictHostKeyChecking=no "${CONTINUUM_SSH_USER:-$(whoami)}@$ip" \
    "cd ~/continuum && docker compose up -d" 2>&1 && {
    echo -e "${GREEN}✅ $node services starting${RESET}"
  } || {
    echo -e "${YELLOW}⚠ SSH failed — node may be powered off${RESET}"
    echo "  If the machine supports Wake-on-LAN:"
    echo "  tailscale ping $node"
  }
}

cmd_provision() {
  local from="${1:-}"
  echo -e "${CYAN}── Provisioning Config ──${RESET}"
  echo ""

  if [ -z "$from" ]; then
    # Auto-discover: find first online grid node
    if command -v tailscale &>/dev/null; then
      from=$(tailscale status 2>/dev/null | grep "\-grid" | grep -v "offline" | awk '{print $1}' | head -1)
      if [ -n "$from" ]; then
        local name
        name=$(tailscale status 2>/dev/null | grep "$from" | awk '{print $2}')
        echo -e "  Auto-discovered: ${GREEN}$name${RESET} ($from)"
      fi
    fi
  fi

  if [ -z "$from" ]; then
    echo -e "${RED}❌ No grid node found.${RESET} Usage: continuum provision <node-ip>"
    exit 1
  fi

  mkdir -p "$CONTINUUM_HOME"
  echo -e "  Pulling config from $from..."
  scp -o ConnectTimeout=5 -o StrictHostKeyChecking=no \
    "joel@$from:~/.continuum/config.env" "$CONTINUUM_HOME/config.env" 2>/dev/null || {
    echo -e "${RED}❌ Failed to pull config${RESET}"
    exit 1
  }
  local count; count=$(grep -c "=" "$CONTINUUM_HOME/config.env" 2>/dev/null || echo 0)
  echo -e "${GREEN}✅ Provisioned: $count keys → $CONTINUUM_HOME/config.env${RESET}"
}

cmd_transfer() {
  local target="${1:?Usage: continuum transfer <target-ip-or-hostname>}"
  echo -e "${BLUE}📦 Transferring Continuum to $target${RESET}"

  local ip=""
  if command -v tailscale &>/dev/null; then
    ip=$(tailscale status 2>/dev/null | grep "$target" | awk '{print $1}' | head -1)
  fi
  [ -z "$ip" ] && ip="$target"

  echo -e "  Step 1: Config..."
  ssh -o StrictHostKeyChecking=no "${CONTINUUM_SSH_USER:-$(whoami)}@$ip" "mkdir -p ~/.continuum" 2>/dev/null
  scp -o StrictHostKeyChecking=no "$CONTINUUM_HOME/config.env" "joel@$ip:~/.continuum/config.env" 2>/dev/null || {
    echo -e "${RED}❌ Failed to copy config${RESET}"; exit 1
  }
  echo -e "  ${GREEN}✓${RESET} Config transferred"

  echo -e "  Step 2: Repo..."
  ssh -o StrictHostKeyChecking=no "${CONTINUUM_SSH_USER:-$(whoami)}@$ip" "
    if [ -d ~/continuum ]; then
      cd ~/continuum && git pull origin main
    else
      git clone https://github.com/CambrianTech/continuum.git ~/continuum
    fi
  " 2>/dev/null || {
    echo -e "${RED}❌ Failed to clone/pull${RESET}"; exit 1
  }
  echo -e "  ${GREEN}✓${RESET} Repo ready"

  echo -e "  Step 3: Starting..."
  ssh -o StrictHostKeyChecking=no "${CONTINUUM_SSH_USER:-$(whoami)}@$ip" "
    cd ~/continuum
    export TS_HOSTNAME=\$(hostname)-grid
    echo \"TS_HOSTNAME=\$TS_HOSTNAME\" > .env
    echo 'COMPOSE_PROFILES=grid' >> .env
    docker compose up -d
  " 2>/dev/null || {
    echo -e "${RED}❌ Failed to start${RESET}"; exit 1
  }
  echo -e "${GREEN}✅ Continuum running on $target!${RESET}"
  echo -e "  Node will appear in your grid shortly."
}

cmd_update() {
  if ! find_compose; then
    echo -e "${RED}❌ No Continuum installation found.${RESET}"
    exit 1
  fi
  cd "$COMPOSE_DIR"
  echo -e "${BLUE}📥 Updating...${RESET}"
  git pull origin main
  echo -e "${BLUE}🔨 Rebuilding...${RESET}"
  docker compose build --parallel
  echo -e "${BLUE}🔄 Restarting...${RESET}"
  docker compose up -d
  echo -e "${GREEN}✅ Updated${RESET}"
}

cmd_tray_data() {
  # JSON output for native tray apps. Single source of truth.
  # Tray apps are thin renderers — they read this and build native menus.
  local docker_ok="false"
  if command -v docker &>/dev/null && docker info &>/dev/null 2>&1; then
    docker_ok="true"
  fi

  # Container health
  local healthy=0 total=0
  if [ "$docker_ok" = "true" ] && find_compose 2>/dev/null; then
    cd "$COMPOSE_DIR"
    healthy=$(docker compose ps --format '{{.Health}}' 2>/dev/null | awk '$0 == "healthy" { count++ } END { print count + 0 }')
    total=$(docker compose ps --format '{{.Name}}' 2>/dev/null | wc -l | tr -d ' ')
  fi

  # Grid nodes
  local nodes_json="[]"
  local suffix=""
  if command -v tailscale &>/dev/null && tailscale status &>/dev/null 2>&1; then
    suffix=$(tailnet_suffix)
    local node_arr="["
    local first=true
    while read -r ip name user os rest; do
      [ -z "$name" ] && continue
      local online="true" ui_ok="false" url="null"
      if echo "$rest" | grep -q "offline"; then
        online="false"
      fi
      local is_grid="false"
      if echo "$name" | grep -q "\-grid"; then
        is_grid="true"
        if [ "$online" = "true" ] && [ -n "$suffix" ]; then
          url="\"https://${name}.${suffix}\""
          local code
          code=$(curl -sk -o /dev/null -w '%{http_code}' --connect-timeout 2 "https://${name}.${suffix}" 2>/dev/null || echo "000")
          if [ "$code" = "200" ]; then ui_ok="true"; fi
        fi
      fi
      [ "$first" = "true" ] && first=false || node_arr="$node_arr,"
      node_arr="$node_arr{\"name\":\"$name\",\"ip\":\"$ip\",\"online\":$online,\"isGrid\":$is_grid,\"uiOk\":$ui_ok,\"url\":$url}"
    done < <(tailscale status 2>/dev/null)
    nodes_json="${node_arr}]"
  fi

  # Status
  local online_count
  online_count=$(echo "$nodes_json" | awk 'BEGIN { count = 0 } { while (match($0, /"online":true/)) { count++; $0 = substr($0, RSTART + RLENGTH) } } END { print count }')

  local status="red" status_text="Not running"
  local native_core="false"
  if is_native_core_running; then
    native_core="true"
  fi
  if [ "$docker_ok" = "false" ] && [ "$online_count" -gt 0 ]; then
    status="yellow"; status_text="Docker off, $online_count grid nodes"
  elif [ "$docker_ok" = "false" ]; then
    if [ "$native_core" = "true" ]; then
      status="green"; status_text="Native core running, Docker off"
    else
      status="red"; status_text="Docker not running"
    fi
  elif [ "$healthy" -ge 4 ]; then
    status="green"; status_text="$healthy services, $online_count nodes"
  elif [ "$healthy" -gt 0 ]; then
    status="yellow"; status_text="$healthy services, $online_count nodes"
  elif [ "$native_core" = "true" ]; then
    status="green"; status_text="Native core running"
  elif [ "$online_count" -gt 0 ]; then
    status="yellow"; status_text="$online_count grid nodes"
  fi

  cat << JSONEOF
{
  "status": "$status",
  "statusText": "$status_text",
  "docker": $docker_ok,
  "nativeCore": $native_core,
  "services": {"healthy": $healthy, "total": $total},
  "tailnet": "$suffix",
  "nodes": $nodes_json,
  "actions": [
    {"id": "start", "label": "Start Services", "command": "continuum start"},
    {"id": "stop", "label": "Stop Services", "command": "continuum stop"},
    {"id": "restart", "label": "Restart Services", "command": "continuum restart"},
    {"id": "doctor", "label": "Doctor", "command": "continuum doctor"},
    {"id": "update", "label": "Update", "command": "continuum update"},
    {"id": "provision", "label": "Provision Config", "command": "continuum provision"},
    {"id": "logs", "label": "Logs", "command": "continuum logs"}
  ],
  "version": "1.0"
}
JSONEOF
}

cmd_doctor() {
  echo -e "${CYAN}── Continuum Doctor ──${RESET}"
  echo ""

  # Docker
  if command -v docker &>/dev/null; then
    if docker info &>/dev/null 2>&1; then
      echo -e "  ${GREEN}●${RESET} Docker: running"
    else
      echo -e "  ${RED}●${RESET} Docker: installed but not running"
    fi
  else
    echo -e "  ${RED}●${RESET} Docker: not installed"
  fi

  # Tailscale
  if command -v tailscale &>/dev/null; then
    if tailscale status &>/dev/null 2>&1; then
      local suffix; suffix=$(tailnet_suffix)
      echo -e "  ${GREEN}●${RESET} Tailscale: connected (${suffix})"
    else
      echo -e "  ${YELLOW}●${RESET} Tailscale: installed but not connected"
    fi
  else
    echo -e "  ${DIM}○${RESET} Tailscale: not installed (grid disabled)"
  fi

  # Config
  if [ -f "$CONTINUUM_HOME/config.env" ]; then
    local count; count=$(grep -c "=" "$CONTINUUM_HOME/config.env" 2>/dev/null || echo 0)
    echo -e "  ${GREEN}●${RESET} Config: $count keys in $CONTINUUM_HOME/config.env"
    if grep -q "TS_AUTHKEY" "$CONTINUUM_HOME/config.env" 2>/dev/null; then
      echo -e "  ${GREEN}●${RESET} Grid auth key: configured"
    else
      echo -e "  ${YELLOW}●${RESET} Grid auth key: not set (add TS_AUTHKEY to config.env)"
    fi
  else
    echo -e "  ${YELLOW}●${RESET} Config: no config.env (run: continuum provision)"
  fi

  # GPU
  if command -v nvidia-smi &>/dev/null 2>&1; then
    local gpu; gpu=$(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null | head -1)
    echo -e "  ${GREEN}●${RESET} GPU: $gpu"
  elif [ "$(uname -s)" = "Darwin" ]; then
    local gpu; gpu=$(system_profiler SPDisplaysDataType 2>/dev/null | grep "Chipset Model" | head -1 | sed 's/.*: //')
    echo -e "  ${GREEN}●${RESET} GPU: $gpu (Apple Silicon)"
  else
    echo -e "  ${DIM}○${RESET} GPU: none detected"
  fi

  # Repo
  if find_compose 2>/dev/null; then
    echo -e "  ${GREEN}●${RESET} Repo: $COMPOSE_DIR"
    local branch; branch=$(cd "$COMPOSE_DIR" && git branch --show-current 2>/dev/null || echo "?")
    echo -e "  ${GREEN}●${RESET} Branch: $branch"
  else
    echo -e "  ${RED}●${RESET} Repo: not found"
  fi

  # Containers
  if find_compose 2>/dev/null; then
    cd "$COMPOSE_DIR"
    local running; running=$(docker compose ps --format '{{.Name}}' 2>/dev/null | wc -l | tr -d ' ')
    local healthy; healthy=$(docker compose ps --format '{{.Health}}' 2>/dev/null | grep -c healthy || true)
    if [ "$running" -gt 0 ]; then
      echo -e "  ${GREEN}●${RESET} Containers: $healthy/$running healthy"
    else
      echo -e "  ${DIM}○${RESET} Containers: none running"
    fi
  fi

  # Submodules — vendored substrates needed for any local build (npm start
  # OR docker build). Empty submodule = silent failures deep in cmake.
  if find_compose 2>/dev/null && [ -d "$COMPOSE_DIR/src/workers/vendor/llama.cpp" ]; then
    if [ -f "$COMPOSE_DIR/src/workers/vendor/llama.cpp/CMakeLists.txt" ]; then
      echo -e "  ${GREEN}●${RESET} Submodules: vendor/llama.cpp populated"
    else
      echo -e "  ${RED}●${RESET} Submodules: vendor/llama.cpp empty (run: git submodule update --init --recursive)"
    fi
  fi

  # IPC sockets — Rust core <-> TS server <-> personas. Sockets missing
  # means containers aren't healthy or weren't started. Quick triage.
  if [ -S "$CONTINUUM_HOME/sockets/continuum-core.sock" ]; then
    echo -e "  ${GREEN}●${RESET} IPC: continuum-core.sock present"
  elif [ -d "$CONTINUUM_HOME/sockets" ]; then
    echo -e "  ${YELLOW}●${RESET} IPC: continuum-core.sock missing (container not up or not yet ready)"
  fi

  # Inference backend — distinguishes GPU vs silent-CPU-fallback. CPU
  # fallback works but at <1/10 the throughput, so it's a real bug to
  # surface. Also distinguishes our scheduler from upstream llama-server
  # in the gpu profile.
  if find_compose 2>/dev/null; then
    cd "$COMPOSE_DIR"
    local core_name
    # `set -e + pipefail` is in effect: protect the pipeline because grep
    # returning 1 on no-match propagates through the substitution and
    # exits the script. We want "no container" to be a clean empty value.
    core_name=$(docker compose ps --format '{{.Name}}' 2>/dev/null | grep -E 'continuum-core(-1)?$' | head -1 || true)
    if [ -n "$core_name" ]; then
      local logs
      logs=$(docker logs "$core_name" 2>&1 | tail -200)
      if echo "$logs" | grep -qiE "ggml-cuda.*reg|cuda.*backend|cuda.*device"; then
        echo -e "  ${GREEN}●${RESET} Backend: CUDA (GPU)"
      elif echo "$logs" | grep -qiE "ggml-metal.*reg|metal.*backend"; then
        echo -e "  ${GREEN}●${RESET} Backend: Metal (Apple GPU)"
      elif echo "$logs" | grep -qiE "backend.*missing|fallback.*cpu|no.*gpu.*backend"; then
        echo -e "  ${RED}●${RESET} Backend: CPU fallback (GPU not engaged — slow!)"
      else
        echo -e "  ${YELLOW}●${RESET} Backend: indeterminate (no backend marker in last 200 log lines)"
      fi
      # Substrate check — our scheduler vs upstream llama-server
      if echo "$logs" | grep -qE "n_seq_max|seq_id|continuous.batch"; then
        echo -e "  ${GREEN}●${RESET} Substrate: continuum scheduler"
      elif echo "$logs" | grep -qE "llama.server.*starting|HTTP server listening"; then
        echo -e "  ${RED}●${RESET} Substrate: upstream llama-server (wrong image — gpu override missing?)"
      fi
    fi
  fi

  # Cloud API keys — distinguishes local-only (intentional) from
  # misconfigured (forgot to add key but expected cloud personas).
  if [ -f "$CONTINUUM_HOME/config.env" ]; then
    local providers
    # Same pipefail caveat as Backend block — grep no-match must not exit.
    providers=$(grep -oE "^(ANTHROPIC|OPENAI|GROQ|XAI|TOGETHER|FIREWORKS|GOOGLE|DEEPSEEK)_API_KEY" "$CONTINUUM_HOME/config.env" 2>/dev/null \
                | sed 's/_API_KEY//' | tr '\n' ' ' || true)
    if [ -n "$providers" ]; then
      echo -e "  ${GREEN}●${RESET} Cloud API keys: $providers"
    else
      echo -e "  ${DIM}○${RESET} Cloud API keys: none (local-only mode)"
    fi
  fi

  # Disk free in $HOME — < 5GB starts failing model downloads silently.
  if command -v df &>/dev/null; then
    local free_gb
    free_gb=$(df -g "$HOME" 2>/dev/null | awk 'NR==2{print $4}' || df -k "$HOME" 2>/dev/null | awk 'NR==2{print int($4/1048576)}')
    if [ -n "$free_gb" ] && [ "$free_gb" -ge 5 ] 2>/dev/null; then
      echo -e "  ${GREEN}●${RESET} Disk free in \$HOME: ${free_gb}G"
    elif [ -n "$free_gb" ]; then
      echo -e "  ${RED}●${RESET} Disk free in \$HOME: ${free_gb}G (low — model downloads need ~5G+)"
    fi
  fi

  echo ""
}

# ── Main ────────────────────────────────────────────────────

case "${1:-}" in
  start)     shift; cmd_start "$@" ;;
  dev)       shift; cmd_dev "$@" ;;
  stop)      shift; cmd_stop "$@" ;;
  restart)   shift; cmd_restart "$@" ;;
  status)    shift; cmd_status "$@" ;;
  health)    shift; cmd_health "$@" ;;
  open)      shift; cmd_open "$@" ;;
  logs)      shift; cmd_logs "$@" ;;
  build)     shift; cmd_build "$@" ;;
  cli)       shift; cmd_cli "$@" ;;
  ssh)       shift; cmd_ssh "$@" ;;
  wake)      shift; cmd_wake "$@" ;;
  provision) shift; cmd_provision "$@" ;;
  transfer)  shift; cmd_transfer "$@" ;;
  update)    shift; cmd_update "$@" ;;
  tray-data) shift; cmd_tray_data "$@" ;;
  doctor)    shift; cmd_doctor "$@" ;;
  help|-h|--help)
    echo "continuum — Distributed AI platform"
    echo ""
    echo -e "${CYAN}Usage:${RESET} continuum [command]"
    echo ""
    echo -e "${CYAN}Local:${RESET}"
    echo "  (none)         Auto-detect: open browser or start"
    echo "  start          Start Docker containers + open browser"
    echo "  stop           Stop containers"
    echo "  restart [svc]  Restart all or one service"
    echo "  status         Show local + grid state"
    echo "  logs [svc]     Tail container logs"
    echo "  dev            Dev mode (npm start)"
    echo "  build          Build Docker images"
    echo "  update         Git pull + rebuild + restart"
    echo "  doctor         Diagnose common problems"
    echo ""
    echo -e "${CYAN}Grid:${RESET}"
    echo "  health         Check all grid nodes"
    echo "  open [node]    Open browser to grid node"
    echo "  ssh <node>     SSH to grid node via Tailscale"
    echo "  wake <node>    Wake + restart downed node"
    echo "  provision      Pull config from grid node"
    echo "  transfer <n>   Deploy Continuum to new machine"
    echo ""
    echo -e "${CYAN}Advanced:${RESET}"
    echo "  cli [cmd]      CLI mode (jtag commands)"
    echo ""
    echo "Examples:"
    echo "  continuum                     # open or start"
    echo "  continuum doctor              # check everything"
    echo "  continuum transfer my-tower   # deploy to new machine"
    echo "  continuum wake bigmama        # restart downed node"
    echo "  continuum ssh bigmama-grid    # shell into grid node"
    echo "  continuum open bigmama-grid   # open node's UI"
    echo "  continuum provision           # pull keys from grid"
    echo ""
    echo -e "Config: ${DIM}~/.continuum/config.env${RESET}"
    ;;
  "")
    # Default: auto-detect
    if has_display; then
      url=$(get_url 2>/dev/null) || {
        cmd_start
        exit $?
      }
      echo -e "${GREEN}✅${RESET} $url"
      open_browser "$url"
    else
      # Headless — show status then drop to CLI hint
      cmd_status
      echo -e "  ${DIM}Run 'continuum cli' for REPL${RESET}"
    fi
    ;;
  *)
    # Unknown command — pass to CLI as jtag command
    cmd_cli "$@"
    ;;
esac
