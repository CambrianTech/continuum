{
  "name": "@jtag-commands/ai/key/remove",
  "version": "1.0.0",
  "description": "Remove an API key for a cloud AI provider. Removes from ~/.continuum/config.env, clears process.env, and emits system:config:key-removed event to deactivate personas.",
