# Node-server Docker context — exclude everything not needed at runtime.
# Target: <500MB context instead of 3.3GB.

# Rust workers — ALL of it except the TS bindings
workers/target/
workers/continuum-core/src/
workers/archive/
workers/inference-grpc/
workers/jtag-mcp/
workers/livekit-bridge/
workers/livekit-protocol/
workers/candle-core-patched/
workers/shared/
workers/Cargo.toml
workers/Cargo.lock
workers/*.sh
workers/*.md
workers/*.json

# Dev artifacts
node_modules/
dist/
.continuum/
.git/
*.log

# Models and media (runtime downloads)
models/
blobs/
datasets/
*.gguf
*.bin
*.safetensors
*.vrm
*.glb

# Projects (ML training, not runtime)
projects/

# Tools (dev utilities)
tools/

# Tests
**/*.test.ts
**/test/
**/__tests__/

# Media files
*.png
*.jpg
*.jpeg
*.mp4
*.wav
*.mp3
