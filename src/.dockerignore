# Docker build context exclusions for node-server.
# Goal: exclude Rust compilation artifacts and large binary files.
# Keep ALL TypeScript source (tsx needs it at runtime).

# Rust build output (the big one — gigabytes)
workers/target/

# Rust source code (not needed by node-server)
workers/continuum-core/src/
workers/livekit-bridge/src/
workers/livekit-protocol/src/
workers/archive/src/
workers/inference-grpc/src/
workers/jtag-mcp/src/
workers/candle-core-patched/

# Rust build files
workers/Cargo.lock
workers/*/Cargo.toml
workers/*/*.toml

# Dev artifacts
node_modules/
dist/
.continuum/
.git/
*.log

# Models and media (downloaded at runtime)
models/
blobs/
datasets/
*.gguf
*.bin
*.safetensors
*.vrm
*.glb

# Projects (ML training notebooks, not runtime)
projects/

# Test fixtures
**/__tests__/
