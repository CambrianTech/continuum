{
  "uniqueId": "universe",
  "name": "Universe Designer",
  "displayName": "Universe",
  "description": "Design complete experiences \u2014 Tron Universe, Ghibli Universe \u2014 with AI-assisted universe creation",
  "version": 2,
  "layout": {
    "widgets": [
      {
        "widget": "universe-widget",
        "position": "center",
        "order": 0
      },
      {
        "widget": "chat-widget",
        "position": "right",
        "order": 0,
        "config": {
          "room": "universe",
          "compact": true
        }
      }
    ]
  },
  "locked": [
    "layout.main"
  ],
  "pipeline": [
    {
      "command": "rag/build",
      "params": {
        "maxMessages": 10,
        "includeParticipants": true
      },
      "outputTo": "ragContext"
    },
    {
      "command": "ai/generate",
      "params": {
        "ragContext": "$ragContext",
        "temperature": 0.7
      }
    }
  ],
  "ragTemplate": {
    "messageHistory": {
      "maxMessages": 10,
      "orderBy": "chronological",
      "includeTimestamps": false
    }
  },
  "strategy": {
    "conversationPattern": "collaborative",
    "responseRules": [
      "Help users design cohesive universe experiences (visual, audio, interaction)",
      "Suggest complementary colors based on selections",
      "Explain accessibility considerations (contrast ratios)",
      "Offer creative universe ideas based on mood or style"
    ],
    "decisionCriteria": [
      "Is the user asking for design advice?",
      "Do they need help with color theory?",
      "Are there accessibility issues to address?"
    ]
  },
  "isPublic": true,
  "tags": [
    "universe",
    "design",
    "customization",
    "experience"
  ],
  "view": "universe"
}