# Voice/ML Models (downloaded automatically, too large for git)
# Use /models/ (root-relative) to avoid catching Rust source dirs like continuum-core/src/models/
/models/

# Python Training Environment
.continuum/genome/python/envs/
.continuum/genome/python/micromamba/
.continuum/genome/python/*.log
.continuum/genome/python/test-*.jsonl

# Training outputs
.continuum/genome/adapters/

# Infrastructure logs (sql, tools, system)
.continuum/jtag/logs/*.log

# Persona cognitive logs (mind, body, soul, cns)
.continuum/personas/*/logs/

# Persona workspaces (sandbox mode runtime data)
.continuum/personas/*/workspace/

# Session runtime data
.continuum/sessions/

# Reports (generated at runtime)
.continuum/reports/

# Blobs (uploaded files, media)
.continuum/blobs/

# Shared runtime state
.continuum/shared/

# Runtime config
.continuum/logging.json
.continuum/test-jobs.json
.continuum/.DS_Store

# Media uploads
.continuum/media/

# Temporary files
/tmp/
*.pyc
__pycache__/

# Micromamba package cache
.continuum/genome/python/pkgs/
system/genome/python/venv/

# Generated TypeScript from Rust via ts-rs (regenerated by: cargo test or npx tsx generator/generate-rust-bindings.ts)
# These MUST be committed — CI needs them to compile and Rust isn't built in CI.
# Regenerate after Rust struct changes: cargo test --package continuum-core --lib

# Auto-generated by build — changes on every npm start
# These MUST be tracked because CI and clean checkouts need them to compile.
# TODO: Make smart-build regenerate these before tsc so they can be gitignored (#587)

# Phantom directory — something creates src/src/ at runtime, should never be committed
# Using exact path to avoid matching legitimate src/ subdirectories elsewhere
/src/

# Auto-generated config (regenerated by: npx tsx generator/generate-config.ts)
# Contains machine-specific paths ($HOME) baked at build time
shared/config.ts

# Generated from SCSS by compile-sass.ts (regenerated by npm start)
# *.styles.ts MUST be committed — CI needs them. Regenerate: npx tsx scripts/compile-sass.ts
widgets/**/public/*.css
widgets/**/public/*.css.map

# Rust build artifacts
# Compiled files
*.o
*.so
*.rlib
*.dll
*.dylib
*.a

# Executables
*.exe

# Cargo build outputs
**/target/
# Cargo.lock committed — consistent dep resolution across platforms

# Rust debug symbols
*.dSYM/

# Rust backup files
**/*.rs.bk
**/*.rs.bk.*
.fastembed_cache/
examples/widget-ui/.continuum/
