# @continuum/web — client config. Copy to `.env` (or `.env.local`) for `vite dev`.
# Both values are REQUIRED; there is no invented default (fail-loud, see src/config.ts).
# Either can be overridden at runtime per-tab via query params (?core=… & ?me=…).

# WS URL of the headless core's thin-client ingress.
# The core only opens this listener when it runs with CONTINUUM_CORE_WS=<port> set
# (there is no hardcoded port), binding 127.0.0.1:<port>. Point this at that:
VITE_CONTINUUM_WS=ws://127.0.0.1:8974

# The human citizen's UUID, sent as chat/send's senderId.
# Explicit until identity pairing lands (tasks #37/#38) — the WS transport
# establishes no session identity yet, so this must be a real user id from the
# core's seeded/registered users, never a fabricated one.
VITE_CONTINUUM_USER_ID=00000000-0000-0000-0000-000000000000
